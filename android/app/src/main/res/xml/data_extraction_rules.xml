<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) replacement for fullBackupContent.
  cloud-backup    = Google account / Google One app backup
  device-transfer = direct device-to-device transfer during setup

  Both are INTENTIONALLY ENABLED for FitLogX so profile, workout history,
  calendar, body measurements and settings can be restored after a reinstall or
  on a new device. No user data is excluded - only volatile caches.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="code_cache/" />
        <exclude domain="external" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="code_cache/" />
        <exclude domain="external" path="cache/" />
    </device-transfer>
</data-extraction-rules>
