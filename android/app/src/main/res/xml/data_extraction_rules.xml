<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) replacement for fullBackupContent.
  cloud-backup  = Google account / Google One app backup
  device-transfer = direct device-to-device transfer during setup

  Both are excluded for FitLogX so a fresh install is always genuinely empty.
  Users move their data with the built-in JSON backup/restore in Settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
