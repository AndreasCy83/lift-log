<?xml version="1.0" encoding="utf-8"?>
<!--
  FitLogX is a local-only app: all workout history and profile data live in the
  Android WebView's localStorage (app_webview/...) plus a few SharedPreferences
  written by Capacitor plugins.

  Android Auto Backup (API 23-30, android:fullBackupContent) is INTENTIONALLY
  ENABLED so a user can restore their data after reinstalling FitLogX or moving
  to a new Android device. Nothing user-created is excluded here.

  Only volatile caches are excluded, because restoring them is useless and can
  ship stale web assets to a new install.
-->
<full-backup-content>
    <!-- Caches only. WebView localStorage/IndexedDB and SharedPreferences are backed up. -->
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="code_cache/" />
    <exclude domain="external" path="cache/" />
</full-backup-content>
